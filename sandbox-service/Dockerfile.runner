FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /opt/revelaai
COPY requirements-runner.txt .
RUN pip install --no-cache-dir -r requirements-runner.txt && \
    useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin sandbox && \
    mkdir -p /opt/revelaai && chown -R 65532:65532 /opt/revelaai
COPY --chown=65532:65532 runner.py /opt/revelaai/runner.py
USER 65532:65532
ENTRYPOINT ["python","-I","-B","/opt/revelaai/runner.py"]
