#!/bin/sh
set -eu

# This hook is intentionally non-destructive: it never deletes or rewrites source.
# It blocks common private-key/secret mistakes before they enter Git history.

staged_names=$(git diff --cached --name-only --diff-filter=ACMR)
if printf '%s\n' "$staged_names" | grep -E '(^|/)(master\.key|license_private\.pem|\.env)$|(^|/)\.revela_recipe(/|$)|(^|/)recipe/.*\.(key|secret)$' >/dev/null 2>&1; then
  echo "ERROR: a private recipe/key file is staged. Remove it from the index and keep it outside Git." >&2
  exit 1
fi

if git diff --cached --unified=0 -- . | grep -E '^\+.*(-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|sk_live_[A-Za-z0-9]{12,}|rk_live_[A-Za-z0-9]{12,})' >/dev/null 2>&1; then
  echo "ERROR: staged changes resemble a private key or live payment secret." >&2
  exit 1
fi

exit 0
